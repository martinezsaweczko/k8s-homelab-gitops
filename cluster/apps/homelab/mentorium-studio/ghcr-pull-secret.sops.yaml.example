# UNENCRYPTED TEMPLATE - two copies of this Secret are needed (same name `ghcr-pull`):
#   1) namespace mentorium-studio -> pod imagePullSecrets (this app dir: ghcr-pull-secret.sops.yaml)
#   2) namespace flux-system      -> ImageRepository secretRef (e.g. ../../../flux-system/ghcr-pull-mentorium-studio.sops.yaml,
#                                    or any dir under cluster/ already reconciled with sops decryption)
# `.dockerconfigjson` is the JSON below. Replace USERNAME / PAT (read:packages) and base64 the "auth"
# value of "USERNAME:PAT". Easiest: kubectl create secret docker-registry ghcr-pull \
#   --docker-server=ghcr.io --docker-username=USERNAME --docker-password=PAT --dry-run=client -o yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: mentorium-studio
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"username":"CHANGE_ME_USERNAME","password":"CHANGE_ME_PAT","auth":"CHANGE_ME_BASE64_OF_USERNAME:PAT"}}}'
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: flux-system
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"username":"CHANGE_ME_USERNAME","password":"CHANGE_ME_PAT","auth":"CHANGE_ME_BASE64_OF_USERNAME:PAT"}}}'
